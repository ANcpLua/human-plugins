#!/bin/zsh
# disk-guard: threshold-triggered cleanup, allowlist-based.
# No-ops unless free space < THRESHOLD_GB. Only touches paths on the explicit
# age-eligible allowlist below, plus tool-native pruning (pnpm, NuGet).
#
# Allowlist (age semantics per row):
#   ~/.codex/sessions, ~/.codex/archived_sessions   14d  per-file
#   ~/Library/Logs/**                               14d  per-file
#   ~/.codex/.tmp                                    7d  per-file
#   RiderProjects bin/obj/artifacts dirs            14d  whole-dir, newest-file
#                                                        probe + git check-ignore
#   ~/.cache/* (except codex-runtimes)              14d  whole-subdir, newest-file probe
# Escalation: 2nd fire within 7 days and still < ESCALATE_GB
#   -> NuGet global-packages clear (all restorable from nuget.org)
set -u

THRESHOLD_GB=${DISK_GUARD_THRESHOLD_GB:-25}
ESCALATE_GB=15
STALE_DAYS=14
LOG="$HOME/Library/Logs/disk-guard.log"
STATE="$HOME/.local/state/disk-guard.last-fire"
PROJECTS="$HOME/RiderProjects"

mkdir -p "${LOG:h}" "${STATE:h}"
free_gb() { df -g / | awk 'NR==2{print $4}'; }
stamp() { date '+%Y-%m-%d %H:%M:%S'; }

# --- repo-hygiene: daily git-index check, independent of free space --------
# Sub-second, no resident process. Notifies only on findings (exit 1);
# exit 0 clean and exit 2 usage errors stay silent in the notification path.
RH="$HOME/.local/bin/repo-hygiene"
if [[ -x "$RH" ]]; then
    rc=0; "$RH" -q "$PROJECTS" 2>/dev/null || rc=$?
    if (( rc == 1 )); then
        print "$(stamp) HYGIENE: build output committed to git:" >> "$LOG"
        "$RH" --color never "$PROJECTS" >> "$LOG" 2>/dev/null || true
        osascript -e 'display notification "Build output committed to git — details in ~/Library/Logs/disk-guard.log" with title "repo-hygiene"' 2>/dev/null
    fi
fi

before=$(free_gb)
if (( before >= THRESHOLD_GB )); then
    print "$(stamp) ok ${before}G free, no action" >> "$LOG"
    exit 0
fi

print "$(stamp) FIRE ${before}G free (< ${THRESHOLD_GB}G)" >> "$LOG"

# --- per-file prunes (then drop emptied subdirs) ---------------------------
prune_files() { # $1=path $2=days
    [[ -d "$1" ]] || return 0
    local n
    n=$(/usr/bin/find "$1" -type f -mtime +"$2" -print -delete 2>/dev/null | wc -l | tr -d ' ')
    /usr/bin/find "$1" -mindepth 1 -type d -empty -delete 2>/dev/null
    (( n > 0 )) && print "$(stamp)   pruned $n files >${2}d from $1" >> "$LOG"
}
prune_files "$HOME/.codex/sessions" "$STALE_DAYS"
prune_files "$HOME/.codex/archived_sessions" "$STALE_DAYS"
prune_files "$HOME/Library/Logs" "$STALE_DAYS"
prune_files "$HOME/.codex/.tmp" 7

# --- TMPDIR: leaked Chrome framework copies --------------------------------
# Chrome writes a ~490M copy of its framework dylib to TMPDIR on each launch and
# fails to remove it; ~17/day accumulate (51 = 9.9G observed 2026-07-28). They are
# closed the moment they are written -- verified none held open via lsof -- and
# Chrome recreates on demand, so anything older than 2h is pure leak.
# minutes, not $STALE_DAYS: at 490M each a 14d window is 100G+.
prune_tmpdir_leaks() {
    local t="${TMPDIR:-/tmp}" n
    [[ -d "$t" ]] || return 0
    n=$(/usr/bin/find "$t" -maxdepth 1 -type f -name '.com.google.Chrome.*' \
        -mmin +120 -print -delete 2>/dev/null | wc -l | tr -d ' ')
    (( n > 0 )) && print "$(stamp)   pruned $n leaked Chrome framework copies from TMPDIR" >> "$LOG"
}
prune_tmpdir_leaks

# --- whole-dir prunes: delete only if NOTHING inside is newer than cutoff --
idle_dir() { # $1=dir $2=days -> success if no recent file
    [[ -z "$(/usr/bin/find "$1" -type f -mtime -"$2" -print -quit 2>/dev/null)" ]]
}
rm_logged() { # $1=dir $2=reason
    local sz
    sz=$(du -sk "$1" 2>/dev/null | awk '{printf "%.1f", $1/1048576}')
    rm -rf "$1" && print "$(stamp)   rm ${sz}G $1 ($2)" >> "$LOG"
}

# build output: artifacts/ needs no git guard (never legitimately tracked);
# bin/obj MUST be git-ignored — repos routinely track a real bin/ of scripts.
/usr/bin/find "$PROJECTS" -maxdepth 4 -type d -iname artifacts -prune 2>/dev/null | while read -r d; do
    idle_dir "$d" "$STALE_DAYS" && rm_logged "$d" "idle artifacts"
done
/usr/bin/find "$PROJECTS" -type d \( -name bin -o -name obj \) -prune 2>/dev/null | while read -r d; do
    git -C "${d:h}" check-ignore --quiet "${d:t}" 2>/dev/null || continue
    idle_dir "$d" "$STALE_DAYS" && rm_logged "$d" "idle git-ignored bin/obj"
done

# ~/.cache subdirs, whole-subdir semantics; codex-runtimes excluded
for d in "$HOME"/.cache/*(N/); do
    [[ "${d:t}" == "codex-runtimes" ]] && continue
    idle_dir "$d" "$STALE_DAYS" && rm_logged "$d" "idle cache"
done

# --- tool-native pruning ---------------------------------------------------
pnpm store prune >/dev/null 2>&1 && print "$(stamp)   pnpm store prune done" >> "$LOG"
dotnet nuget locals http-cache --clear >/dev/null 2>&1 && print "$(stamp)   nuget http-cache cleared" >> "$LOG"
# brew build scratch: abandoned on every interrupted/failed build, never self-cleans
prune_files "/opt/homebrew/var/homebrew/tmp" 1
/usr/bin/find /opt/homebrew/var/homebrew/tmp -mindepth 1 -type d -empty -delete 2>/dev/null
brew cleanup --prune=all >/dev/null 2>&1 && print "$(stamp)   brew cleanup done" >> "$LOG"

# --- escalation: 2nd fire within 7 days and still critically low -----------
now=$(date +%s)
last=$(cat "$STATE" 2>/dev/null || print 0)
print "$now" > "$STATE"
if (( now - last < 7*86400 )) && (( $(free_gb) < ESCALATE_GB )); then
    dotnet nuget locals global-packages --clear >/dev/null 2>&1 \
        && print "$(stamp)   ESCALATED: nuget global-packages cleared (2nd fire in 7d)" >> "$LOG"
fi

print "$(stamp) done, $(free_gb)G free (was ${before}G)" >> "$LOG"
