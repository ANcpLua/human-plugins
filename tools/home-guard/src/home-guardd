#!/bin/zsh
# home-guard: enforce the top-level $HOME invariant.
# Everything directly in $HOME must be a directory (or a symlink resolving to
# one) or a dotfile; the only allowed plain files are the AI instruction files
# in ALLOW. Anything else is moved to ~/REVIEW-REQUIRED for manual triage.
# Never recurses — rules for lower levels are inherited from ~/.claude and
# ~/.codex, which live at exactly this directory level.
set -u

REVIEW="${HOME_GUARD_REVIEW_DIR:-$HOME/REVIEW-REQUIRED}"
LOG="$HOME/Library/Logs/home-guard.log"
typeset -ra ALLOW=(AGENTS.md CLAUDE.md CLAUDE.local.md GEMINI.md)

[[ -n "${HOME:-}" ]] || exit 2
mkdir -p "$HOME" "$REVIEW" "${LOG:h}"
stamp() { date '+%Y-%m-%d %H:%M:%S'; }

# Default glob (no D flag) skips dotfiles/dotdirs by construction — the
# config domain is never touched.
moved=0
for f in "$HOME"/*(N); do
    name="${f:t}"
    [[ -d "$f" ]] && continue                    # dirs + symlinks to dirs
    (( ${ALLOW[(Ie)$name]} )) && continue        # AI instruction files
    dest="$REVIEW/$name"
    # mv -n exits 0 even when it moves nothing (BSD), so pre-resolve
    # collisions and verify the source is actually gone afterwards.
    [[ -e "$dest" || -L "$dest" ]] && dest="$REVIEW/${name}.$(date +%Y%m%d%H%M%S).$$"
    if mv -n "$f" "$dest" 2>/dev/null && [[ ! -e "$f" && ! -L "$f" ]]; then
        print "$(stamp) moved: $name -> ${dest#$HOME/}" >> "$LOG"
        (( moved++ ))
    else
        print "$(stamp) FAILED to move: $name" >> "$LOG"
    fi
done
# Quiet on no-op runs: WatchPaths fires often; the log stays signal-only.
(( moved )) && print "$(stamp) sweep done: $moved item(s) moved" >> "$LOG"
exit 0
