{
  "$schema": "../../pipeline/tool.schema.json",
  "schemaVersion": 1,
  "id": "home-guard",
  "displayName": "Home Guard",
  "summary": "Keeps the top level of $HOME to directories, dotfiles, and allowlisted AI instruction files; strays move to ~/REVIEW-REQUIRED.",
  "status": "active",
  "kind": "automation",
  "license": "MIT",
  "platforms": ["macos"],
  "source": {
    "repository": "ANcpLua/human-plugins",
    "path": "tools/home-guard"
  },
  "pipeline": {
    "macos": {
      "runner": "macos-15",
      "stages": {
        "check": [
          {
            "name": "syntax",
            "run": ["zsh", "-n", "src/home-guardd"]
          },
          {
            "name": "launchd-plist",
            "run": ["plutil", "-lint", "launchd/dev.ancplua.home-guard.plist"]
          }
        ],
        "build": [
          {
            "name": "stage-executable",
            "run": ["/usr/bin/install", "-m", "755", "src/home-guardd", "{build}/home-guardd"]
          }
        ],
        "test": [
          {
            "name": "sweep-and-noop",
            "run": ["bash", "tests/sweep-and-noop.sh", "{build}/home-guardd", "{build}/test-home"]
          }
        ],
        "smoke": [
          {
            "name": "packaged-empty-home-noop",
            "run": ["python3", "{root}/pipeline/probe.py", "exec", "{package}", "bin/home-guardd"],
            "env": {
              "HOME": "{build}/smoke-home"
            }
          }
        ]
      }
    }
  },
  "package": {
    "files": [
      {
        "source": "{build}/home-guardd",
        "destination": "bin/home-guardd"
      },
      {
        "source": "launchd/dev.ancplua.home-guard.plist",
        "destination": "services/macos/dev.ancplua.home-guard.plist"
      }
    ]
  },
  "install": {
    "links": [
      {
        "payload": "bin/home-guardd",
        "target": "~/.local/bin/home-guardd"
      }
    ],
    "services": {
      "macos": [
        {
          "template": "services/macos/dev.ancplua.home-guard.plist",
          "target": "~/Library/LaunchAgents/dev.ancplua.home-guard.plist",
          "id": "dev.ancplua.home-guard",
          "activate": true
        }
      ]
    },
    "health": {
      "macos": [
        {
          "name": "sweep-runs-clean",
          "run": ["{current}/bin/home-guardd"],
          "env": {
            "HOME": "{home}"
          }
        }
      ]
    }
  }
}
