{
  "$schema": "../../pipeline/tool.schema.json",
  "schemaVersion": 1,
  "id": "opusbreak",
  "displayName": "opusbreak",
  "summary": "Caches Anthropic service status and renders concise human or model advisories.",
  "status": "active",
  "kind": "automation",
  "license": "MIT",
  "platforms": ["macos", "linux"],
  "source": {
    "repository": "ANcpLua/human-plugins",
    "path": "tools/opusbreak",
    "migratedFrom": "ANcpLua/opusbreak",
    "migratedCommit": "050535b4be529ffe74e4bb8c926864ff39037d3f"
  },
  "pipeline": {
    "macos": {
      "runner": "macos-15",
      "stages": {
        "check": [
          {"name": "cli-syntax", "run": ["node", "--check", "bin/opusbreak"]},
          {"name": "status-syntax", "run": ["node", "--check", "src/status.mjs"]},
          {"name": "analysis-syntax", "run": ["node", "--check", "src/analysis.mjs"]},
          {"name": "launchd-plist", "run": ["plutil", "-lint", "launchd/com.ancplua.opusbreak.plist"]}
        ],
        "build": [
          {"name": "build-directories", "run": ["/bin/mkdir", "-p", "{build}/bin", "{build}/src"]},
          {"name": "stage-cli", "run": ["/usr/bin/install", "-m", "755", "bin/opusbreak", "{build}/bin/opusbreak"]},
          {"name": "stage-status", "run": ["/usr/bin/install", "-m", "644", "src/status.mjs", "{build}/src/status.mjs"]},
          {"name": "stage-analysis", "run": ["/usr/bin/install", "-m", "644", "src/analysis.mjs", "{build}/src/analysis.mjs"]}
        ],
        "test": [
          {"name": "self-test", "run": ["node", "tests/self-test.mjs"]}
        ],
        "smoke": [
          {"name": "packaged-self-test", "run": ["python3", "{root}/pipeline/probe.py", "exec", "{package}", "bin/opusbreak", "--", "self-test"]}
        ]
      }
    },
    "linux": {
      "runner": "ubuntu-24.04",
      "stages": {
        "check": [
          {"name": "cli-syntax", "run": ["node", "--check", "bin/opusbreak"]},
          {"name": "status-syntax", "run": ["node", "--check", "src/status.mjs"]},
          {"name": "analysis-syntax", "run": ["node", "--check", "src/analysis.mjs"]},
          {"name": "render-service", "run": ["python3", "{root}/pipeline/service.py", "systemd/opusbreak.service", "{build}/opusbreak.service", "--home", "/tmp/human-tools-home", "--current", "/tmp/human-tools-current"]},
          {"name": "systemd-service", "run": ["systemd-analyze", "verify", "{build}/opusbreak.service"]},
          {"name": "systemd-timer", "run": ["systemd-analyze", "verify", "systemd/opusbreak.timer"]}
        ],
        "build": [
          {"name": "build-directories", "run": ["/bin/mkdir", "-p", "{build}/bin", "{build}/src"]},
          {"name": "stage-cli", "run": ["/usr/bin/install", "-m", "755", "bin/opusbreak", "{build}/bin/opusbreak"]},
          {"name": "stage-status", "run": ["/usr/bin/install", "-m", "644", "src/status.mjs", "{build}/src/status.mjs"]},
          {"name": "stage-analysis", "run": ["/usr/bin/install", "-m", "644", "src/analysis.mjs", "{build}/src/analysis.mjs"]}
        ],
        "test": [
          {"name": "self-test", "run": ["node", "tests/self-test.mjs"]}
        ],
        "smoke": [
          {"name": "packaged-self-test", "run": ["python3", "{root}/pipeline/probe.py", "exec", "{package}", "bin/opusbreak", "--", "self-test"]}
        ]
      }
    }
  },
  "package": {
    "files": [
      {"source": "{build}/bin/opusbreak", "destination": "bin/opusbreak"},
      {"source": "{build}/src/status.mjs", "destination": "src/status.mjs"},
      {"source": "{build}/src/analysis.mjs", "destination": "src/analysis.mjs"},
      {"source": "launchd/com.ancplua.opusbreak.plist", "destination": "services/macos/com.ancplua.opusbreak.plist"},
      {"source": "systemd/opusbreak.service", "destination": "services/linux/opusbreak.service"},
      {"source": "systemd/opusbreak.timer", "destination": "services/linux/opusbreak.timer"}
    ]
  },
  "install": {
    "links": [
      {"payload": "bin/opusbreak", "target": "~/.local/bin/opusbreak"}
    ],
    "services": {
      "macos": [
        {
          "template": "services/macos/com.ancplua.opusbreak.plist",
          "target": "~/Library/LaunchAgents/com.ancplua.opusbreak.plist",
          "id": "com.ancplua.opusbreak",
          "activate": true
        }
      ],
      "linux": [
        {
          "template": "services/linux/opusbreak.service",
          "target": "~/.config/systemd/user/opusbreak.service",
          "id": "opusbreak.service",
          "activate": false
        },
        {
          "template": "services/linux/opusbreak.timer",
          "target": "~/.config/systemd/user/opusbreak.timer",
          "id": "opusbreak.timer",
          "activate": true
        }
      ]
    },
    "health": {
      "macos": [
        {"name": "self-test", "run": ["{current}/bin/opusbreak", "self-test"]}
      ],
      "linux": [
        {"name": "self-test", "run": ["{current}/bin/opusbreak", "self-test"]}
      ]
    }
  }
}
