#!/usr/bin/env node
import assert from "node:assert/strict";

import { analyze, fetchIncidents, markdown, poissonInterval } from "../src/analysis.mjs";
import {
  degraded,
  normalizeSummary,
  poll,
  readCache,
  renderAdvisory,
  renderStatusline,
} from "../src/status.mjs";

function usage() {
  console.log(`opusbreak — Anthropic service status

usage: opusbreak <poll|statusline|advisory|analyze|self-test>

  poll                 refresh the local status cache
  statusline           print a compact segment; empty when healthy
  advisory             print model-readable degradation details
  analyze [--json]     rank incident windows from the public archive
  self-test            exercise pure status and statistics logic`);
}

async function cacheOutput(renderer) {
  try {
    process.stdout.write(renderer(await readCache()));
  } catch (error) {
    if (error?.code !== "ENOENT") throw error;
  }
}

function selfTest() {
  const body = {
    status: { indicator: "none", description: "All Systems Operational" },
    components: [
      { id: "k8w3r06qmzrp", name: "Claude API", status: "operational" },
      { id: "ignored", name: "Other", status: "major_outage" },
    ],
    incidents: [],
    scheduled_maintenances: [],
  };
  const cache = normalizeSummary(body, 12, "2026-01-01T00:00:00.000Z");
  assert.equal(cache.components.length, 1);
  assert.equal(degraded(cache), false);
  assert.equal(renderStatusline(cache, Date.parse("2026-01-01T00:05:00Z")), "");
  cache.indicator = "major";
  assert.match(renderStatusline(cache, Date.parse("2026-01-01T00:05:00Z")), /🔴/);
  assert.equal(poissonInterval(0, 10).method, "rule_of_three");
  assert.equal(analyze([{ created_at: "2025-12-01T10:00:00Z" }], "UTC", Date.parse("2026-01-01")).incidents, 1);
  console.log("opusbreak self-test: ok");
}

async function main() {
  const [command = "help", ...arguments_] = process.argv.slice(2);
  if (command === "poll") {
    const cache = await poll();
    console.log(`opusbreak: ${cache.description} (${cache.elapsedMs}ms)`);
    return degraded(cache) ? 2 : 0;
  }
  if (command === "statusline") {
    await cacheOutput(renderStatusline);
    return 0;
  }
  if (command === "advisory") {
    await cacheOutput(renderAdvisory);
    return 0;
  }
  if (command === "analyze") {
    const timezoneIndex = arguments_.indexOf("--timezone");
    const timezone = timezoneIndex >= 0 ? arguments_[timezoneIndex + 1] : "UTC";
    const report = analyze(await fetchIncidents(), timezone);
    console.log(arguments_.includes("--json") ? JSON.stringify(report, null, 2) : markdown(report));
    return 0;
  }
  if (command === "self-test" || command === "--self-test") {
    selfTest();
    return 0;
  }
  usage();
  return command === "help" || command === "--help" ? 0 : 2;
}

process.exitCode = await main();
